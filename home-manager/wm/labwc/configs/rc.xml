<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>


  <core>
    <decoration>server</decoration>
    <gap>12</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <autoEnableOutputs>yes</autoEnableOutputs>
    <hdr>no</hdr>
    <reuseOutputMode>no</reuseOutputMode>
    <xwaylandPersistence>no</xwaylandPersistence>
    <primarySelection>yes</primarySelection>
  </core>

  <focus>
    <followMouse>no</followMouse>
  </focus>

  <placement>
    <policy>cascade</policy>
    <cascadeOffset x="40" y="30" />
  </placement>

    <desktops>
      <popupTime>1000</popupTime>
      <initial>Workspace 1</initial>
      <names>
        <name>web</name>
        <name>dev</name>
        <name>work</name>
      </names>
    </desktops>


  <regions>
    <region name="top-left"     x="0%"  y="0%"  height="50%"  width="50%"  />
    <region name="top"          x="0%"  y="0%"  height="50%"  width="100%" />
    <region name="top-right"    x="50%" y="0%"  height="50%"  width="50%"  />
    <region name="left"         x="0%"  y="0%"  height="100%" width="50%"  />
    <region name="center"       x="10%" y="10%" height="80%"  width="80%"  />
    <region name="right"        x="50%" y="0%"  height="100%" width="50%"  />
    <region name="bottom-left"  x="0%"  y="50%" height="50%"  width="50%"  />
    <region name="bottom"       x="0%"  y="50%" height="50%"  width="100%" />
    <region name="bottom-right" x="50%" y="50%" height="50%"  width="50%"  />
  </regions>

  <theme>
    <cornerRadius>0</cornerRadius>
    <font place="ActiveWindow"><name>JetBrains Mono</name><size>10</size></font>
    <font place="MenuItem"><name>JetBrains Mono</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>JetBrains Mono</name><size>10</size></font>
  </theme>

  <windowSwitcher preview="yes" outlines="yes">
    <osd show="no"/>
  </windowSwitcher>

  <keyboard>
    <numlock>on</numlock>

    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>

    <default/>

    <keybind key="W-Return"><action name="Execute"><command>alacritty</command></action></keybind>
    <keybind key="W-d"><action name="Execute"><command>rofi -show drun</command></action></keybind>
    <keybind key="A-l"><action name="Execute"><command>swaylock</command></action></keybind>

    <keybind key="W-Home">
      <action name="Execute" command="systemctl reboot" />
    </keybind>

    <keybind key="W-End">
      <action name="Execute" command="systemctl poweroff" />
    </keybind>


    <keybind key="W-n">
      <action name="Execute">
        <command>sh -c 'if systemctl --user is-active --quiet wlsunset.service; then systemctl --user stop wlsunset.service;  else systemctl --user start wlsunset.service;  fi'</command>
      </action>
    </keybind>

    <!-- ============== PENCERE YÖNETİMİ ============== -->
    <keybind key="W-q"><action name="Close"/></keybind>
    <keybind key="W-f"><action name="ToggleMaximize"/></keybind>


    <!-- Masaüstüne doğrudan geçiş -->
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>

    <!-- Pencereyi masaüstüne gönder (follow=no: geçerli masaüstünde kal) -->
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no"/></keybind>


    <!-- 7 = top-left -->
    <keybind key="W-KP_7"><action name="SnapToRegion" region="top-left"/></keybind>
    <keybind key="W-KP_Home"><action name="SnapToRegion" region="top-left"/></keybind>
    <!-- 8 = top -->
    <keybind key="W-KP_8"><action name="SnapToRegion" region="top"/></keybind>
    <keybind key="W-KP_Up"><action name="SnapToRegion" region="top"/></keybind>
    <!-- 9 = top-right -->
    <keybind key="W-KP_9"><action name="SnapToRegion" region="top-right"/></keybind>
    <keybind key="W-KP_Prior"><action name="SnapToRegion" region="top-right"/></keybind>
    <!-- 4 = left -->
    <keybind key="W-KP_4"><action name="SnapToRegion" region="left"/></keybind>
    <keybind key="W-KP_Left"><action name="SnapToRegion" region="left"/></keybind>
    <!-- 5 = center -->
    <keybind key="W-KP_5"><action name="SnapToRegion" region="center"/></keybind>
    <keybind key="W-KP_Begin"><action name="SnapToRegion" region="center"/></keybind>
    <!-- 6 = right -->
    <keybind key="W-KP_6"><action name="SnapToRegion" region="right"/></keybind>
    <keybind key="W-KP_Right"><action name="SnapToRegion" region="right"/></keybind>
    <!-- 1 = bottom-left -->
    <keybind key="W-KP_1"><action name="SnapToRegion" region="bottom-left"/></keybind>
    <keybind key="W-KP_End"><action name="SnapToRegion" region="bottom-left"/></keybind>
    <!-- 2 = bottom -->
    <keybind key="W-KP_2"><action name="SnapToRegion" region="bottom"/></keybind>
    <keybind key="W-KP_Down"><action name="SnapToRegion" region="bottom"/></keybind>
    <!-- 3 = bottom-right -->
    <keybind key="W-KP_3"><action name="SnapToRegion" region="bottom-right"/></keybind>
    <keybind key="W-KP_Next"><action name="SnapToRegion" region="bottom-right"/></keybind>

    <!-- ============== EKRAN GÖRÜNTÜSÜ ============== -->
    <keybind key="Print"><action name="Execute"><command>grim</command></action></keybind>
    <keybind key="W-S-s"><action name="Execute"><command>sh -c 'grim -g "$(slurp)" - | wl-copy'</command></action></keybind>

    <!-- ============== SES (fiziksel medya tuşları) ==============
          -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>sh -c 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+; wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk "{print int(\$2*100)}" &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>sh -c 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-; wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk "{print int(\$2*100)}" &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>sh -c 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@); echo "$v" | grep -q MUTED &amp;&amp; echo 0 &gt; "$XDG_RUNTIME_DIR/wob.fifo" || echo "$v" | awk "{print int(\$2*100)}" &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></keybind>
    <!-- Mikrofon susturma: OSD'siz (mikrofon seviyesi göstergesi gereksiz). -->
    <keybind key="XF86AudioMicMute"><action name="Execute"><command>sh -c 'wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle'</command></action></keybind>

    <!-- ============== PARLAKLIK ==============
          -->
    <keybind key="XF86AudioNext"><action name="Execute"><command>sh -c 'brightnessctl -q set 5%+; brightnessctl -m | cut -d, -f4 | tr -d % &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute"><command>sh -c 'brightnessctl -q set 5%-; brightnessctl -m | cut -d, -f4 | tr -d % &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></keybind>
    <!-- Harici klavye/dock takılırsa standart tuşlar da çalışsın. -->
    <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>sh -c 'brightnessctl -q set 5%+; brightnessctl -m | cut -d, -f4 | tr -d % &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>sh -c 'brightnessctl -q set 5%-; brightnessctl -m | cut -d, -f4 | tr -d % &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></keybind>
  </keyboard>

  <mouse>
    <default/>

    <!-- ====== Super + Tekerlek = SES, Super+Shift + Tekerlek = PARLAKLIK ======
         -->
    <context name="Frame">
      <mousebind direction="W-Up"   action="Scroll"><action name="Execute"><command>sh -c 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+; wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk "{print int(\$2*100)}" &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></mousebind>
      <mousebind direction="W-Down" action="Scroll"><action name="Execute"><command>sh -c 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-; wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk "{print int(\$2*100)}" &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></mousebind>
      <mousebind direction="W-S-Up"   action="Scroll"><action name="Execute"><command>sh -c 'brightnessctl -q set 5%+; brightnessctl -m | cut -d, -f4 | tr -d % &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></mousebind>
      <mousebind direction="W-S-Down" action="Scroll"><action name="Execute"><command>sh -c 'brightnessctl -q set 5%-; brightnessctl -m | cut -d, -f4 | tr -d % &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></mousebind>
    </context>

    <context name="Root">
      <mousebind direction="W-Up"   action="Scroll"><action name="Execute"><command>sh -c 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+; wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk "{print int(\$2*100)}" &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></mousebind>
      <mousebind direction="W-Down" action="Scroll"><action name="Execute"><command>sh -c 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-; wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk "{print int(\$2*100)}" &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></mousebind>
      <mousebind direction="W-S-Up"   action="Scroll"><action name="Execute"><command>sh -c 'brightnessctl -q set 5%+; brightnessctl -m | cut -d, -f4 | tr -d % &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></mousebind>
      <mousebind direction="W-S-Down" action="Scroll"><action name="Execute"><command>sh -c 'brightnessctl -q set 5%-; brightnessctl -m | cut -d, -f4 | tr -d % &gt; "$XDG_RUNTIME_DIR/wob.fifo"'</command></action></mousebind>
    </context>
  </mouse>

  <windowRules>
    <windowRule identifier="*">
      <action name="SetDecorations" decorations="border" forceSSD="yes"/>
    </windowRule>

    <windowRule identifier="*firefox*" type="normal">
      <action name="Maximize"/>
    </windowRule>

    <windowRule identifier="tr-com-havelsan-uyap-system-editor-common-WPAppManager">
      <action name="SendToDesktop" to="work" follow="yes" />
    </windowRule>



  
  </windowRules>

</labwc_config>
