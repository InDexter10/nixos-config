<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <!-- ============================ CEKIRDEK ============================ -->
  <!-- Bilesik sunucu davranisi. Cogu deger labwc varsayilani ile aynidir;
       deterministik olsun diye acikca yazilmistir. -->
  <core>
    <decoration>server</decoration>               <!-- Pencere cercevelerini labwc cizer (SSD) -->
    <gap>0</gap>                                   <!-- Tasima/snap sirasinda kenar boslugu (px) -->
    <adaptiveSync>no</adaptiveSync>               <!-- VRR/FreeSync kapali -->
    <allowTearing>no</allowTearing>               <!-- Ekran yirtilmasina izin verme -->
    <autoEnableOutputs>yes</autoEnableOutputs>    <!-- Ekranlari otomatik etkinlestir (kanshi kullanmiyorsan 'yes' birak) -->
    <hdr>no</hdr>                                  <!-- HDR kapali -->
    <reuseOutputMode>no</reuseOutputMode>         <!-- Acilista mevcut cozunurluk modu yeniden kullanilmasin -->
    <xwaylandPersistence>no</xwaylandPersistence> <!-- Son X uygulamasi kapaninca Xwayland'i kapat (saldiri yuzeyini kucultur) -->
    <primarySelection>yes</primarySelection>      <!-- Orta-tik yapistir (PRIMARY selection) acik -->
  </core>

  <!-- ============================== ODAK ============================== -->
  <!-- Tikla-odaklan: fare bir pencere uzerine gelince odak degismez. -->
  <focus>
    <followMouse>no</followMouse>
  </focus>

  <!-- ============================ YERLESIM ============================ -->
  <!-- Yeni pencereler ekranin ortasinda acilir. -->
  <placement>
    <policy>center</policy>
  </placement>

  <!-- ======================= CALISMA ALANLARI ======================== -->
  <!-- Sabit 4 masaustu (labwc'de dinamik workspace yerlesik degildir). -->
  <desktops number="4">
    <popupTime>700</popupTime>                    <!-- Masaustu adi gostergesinin ekranda kalma suresi (ms) -->
  </desktops>

  <!-- ======================== SNAP BOLGELERI ========================= -->
  <!-- Super tusu basili tutup surukledikce pencerenin oturacagi bolgeler. -->
  <regions>
    <region name="left"   x="0%"  y="0%"  width="50%" height="100%"/>
    <region name="right"  x="50%" y="0%"  width="50%" height="100%"/>
    <region name="center" x="15%" y="10%" width="70%" height="80%"/>
  </regions>

  <!-- ============================== TEMA ============================== -->
  <!-- Renkler burada DEGIL; ayni dizindeki 'themerc-override' dosyasindadir
       (BreezeDark kenarlik/menu/OSD renkleri). Burada yalnizca kose ve font. -->
  <theme>
    <cornerRadius>0</cornerRadius>                <!-- Keskin koseler (yuvarlatma yok) -->
    <!-- labwc'nin kendi metni (menu + OSD) sistem UI fontu (Arial) ile ayni.
         Baslik cubugu yok (border-only) oldugu icin ActiveWindow pratikte gorunmez,
         ileride titlebar acarsan tutarli olsun diye birakildi. -->
    <font place="ActiveWindow"><name>Arial</name><size>10</size></font>
    <font place="MenuItem"><name>Arial</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Arial</name><size>10</size></font>
  </theme>

  <!-- Alt-Tab penceresi: onizleme + cerceve goster, OSD metnini gizle. -->
  <windowSwitcher preview="yes" outlines="yes">
    <osd show="no"/>
  </windowSwitcher>

  <!-- ============================= KLAVYE ============================= -->
  <keyboard>
    <default/>  <!-- labwc'nin yerlesik kisayollari (A-Tab, W-ok ile tasi vb.) -->

    <!-- Uygulama baslatma -->
    <keybind key="W-Return"><action name="Execute"><command>alacritty</command></action></keybind>
    <keybind key="W-d"><action name="Execute"><command>rofi -show drun</command></action></keybind>
    <keybind key="A-l"><action name="Execute"><command>swaylock</command></action></keybind>

    <!-- Pencere yonetimi -->
    <keybind key="W-q"><action name="Close"/></keybind>
    <keybind key="W-f"><action name="ToggleMaximize"/></keybind>

    <!-- Yari-ekran kenetleme - vim tuslari (combine=yes ile kose ceyrekleri de mumkun) -->
    <keybind key="W-h"><action name="SnapToEdge" direction="left"  combine="yes"/></keybind>
    <keybind key="W-j"><action name="SnapToEdge" direction="down"  combine="yes"/></keybind>
    <keybind key="W-k"><action name="SnapToEdge" direction="up"    combine="yes"/></keybind>
    <keybind key="W-l"><action name="SnapToEdge" direction="right" combine="yes"/></keybind>

    <!-- Masaustune dogrudan gecis -->
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4"/></keybind>
    <keybind key="C-A-Left"><action name="GoToDesktop" to="left"/></keybind>
    <keybind key="C-A-Right"><action name="GoToDesktop" to="right"/></keybind>

    <!-- Pencereyi masaustune gonder (follow=no: gecerli masaustunde kal) -->
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no"/></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no"/></keybind>

    <!-- Ekran goruntusu (grim + slurp + wl-clipboard kurulu olmali) -->
    <keybind key="Print"><action name="Execute"><command>grim</command></action></keybind>
    <keybind key="W-S-s"><action name="Execute"><command>sh -c 'grim -g "$(slurp)" - | wl-copy'</command></action></keybind>

    <!-- Ses: fiziksel medya tuslari; eylem + ekran gostergesi swayosd ile -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>swayosd-client --output-volume raise</command></action></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>swayosd-client --output-volume lower</command></action></keybind>
    <keybind key="XF86AudioMute"><action name="Execute"><command>swayosd-client --output-volume mute-toggle</command></action></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute"><command>swayosd-client --input-volume mute-toggle</command></action></keybind>

    <!-- Parlaklik: bu klavyede ayri parlaklik tusu yok. Medya ileri/geri
         tuslari parlaklik kontrolune atandi (iz atlama islevini devre disi birakir). -->
    <keybind key="XF86AudioNext"><action name="Execute"><command>swayosd-client --brightness raise</command></action></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute"><command>swayosd-client --brightness lower</command></action></keybind>

    <!-- Standart parlaklik tuslari: harici klavye/dock takilirsa calisir.
         Gerekmezse bu iki satir guvenle silinebilir. -->
    <keybind key="XF86MonBrightnessUp"><action name="Execute"><command>swayosd-client --brightness raise</command></action></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute"><command>swayosd-client --brightness lower</command></action></keybind>
  </keyboard>

  <!-- ============================== FARE ============================== -->
  <mouse>
    <default/>  <!-- labwc'nin yerlesik fare baglamalari -->
  </mouse>

  <!-- ======================== PENCERE KURALLARI ====================== -->
  <windowRules>
    <!-- Tum pencereler: yalnizca kenarlik (baslik cubugu yok).
         forceSSD=yes, kendi cercevesini cizen (CSD) uygulamalari da SSD'ye zorlar. -->
    <windowRule identifier="*">
      <action name="SetDecorations" decorations="border" forceSSD="yes"/>
    </windowRule>

    <!-- Firefox acildiginda buyutulmus gelsin -->
    <windowRule identifier="*firefox*" type="normal">
      <action name="Maximize"/>
    </windowRule>
  </windowRules>

</labwc_config>
