<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>12</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <autoEnableOutputs>yes</autoEnableOutputs>
    <reuseOutputMode>no</reuseOutputMode>
    <xwaylandPersistence>no</xwaylandPersistence>
    <primarySelection>yes</primarySelection>

    <hdr>no</hdr>
  </core>

  <focus>
    <followMouse>no</followMouse>
  </focus>

  <placement>
    <policy>cascade</policy>
    <cascadeOffset x="40" y="30" />
  </placement>

  <desktops>
    <popupTime>800</popupTime>
    <initial>I</initial>
    <names>
      <name>I</name>
      <name>II</name>
      <name>III</name>
    </names>
  </desktops>

  <snapping>
    <range><inner>16</inner><outer>16</outer></range>
    <cornerRange>60</cornerRange>
    <overlay>
      <enabled>yes</enabled>
      <delay><inner>200</inner><outer>200</outer></delay>
    </overlay>
    <topMaximize>yes</topMaximize>
  </snapping>

  <regions>
    <region name="top-left"     x="0%"  y="0%"  height="50%"  width="50%"  />
    <region name="top"          x="0%"  y="0%"  height="50%"  width="100%" />
    <region name="top-right"    x="50%" y="0%"  height="50%"  width="50%"  />
    <region name="left"         x="0%"  y="0%"  height="100%" width="50%"  />
    <region name="center"       x="10%" y="10%" height="80%"  width="80%"  />
    <region name="right"        x="50%" y="0%"  height="100%" width="50%"  />
    <region name="bottom-left"  x="0%"  y="50%" height="50%"  width="50%"  />
    <region name="bottom"       x="0%"  y="50%" height="50%"  width="100%" />
    <region name="bottom-right" x="50%" y="50%" height="50%"  width="50%"  />
  </regions>

  <theme>
    <cornerRadius>0</cornerRadius>

    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>

    <font place="ActiveWindow"><name>Inter</name><size>10</size></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="MenuHeader"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
  </theme>

  <windowSwitcher preview="yes" outlines="yes" order="focus">
    <osd show="no" style="thumbnail" output="all" />
  </windowSwitcher>

  <keyboard>
    <numlock>on</numlock>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>
    <default/>

    <!-- UYGULAMA / SISTEM -->
    <keybind key="W-Return"><action name="Execute"><command>foot --app-id=foot-main</command></action></keybind>
    <keybind key="W-e"><action name="Execute"><command>foot yazi</command></action></keybind>
    <keybind key="W-d"><action name="Execute"><command>rofi -no-plugins -show drun</command></action></keybind>

    <!-- Gece isigi ac/kapa -->
    <keybind key="W-n">
  <action name="Execute">
    <command>sh -c 'if systemctl --user is-active --quiet wlsunset.service; then systemctl --user stop wlsunset.service; else systemctl --user start wlsunset.service; fi'</command>
  </action>
    </keybind>

    <keybind key="W-space"><action name="ToggleShowDesktop"/></keybind>

    <!-- PENCERE -->
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="W-q"><action name="Close"/></keybind>

    <keybind key="W-f"><action name="ToggleMaximize"/></keybind>
    <keybind key="F11"><action name="ToggleFullscreen"/></keybind>

    <keybind key="W-c"><action name="ToggleSnapToEdge" direction="center"/></keybind>
    <keybind key="W-m"><action name="Iconify"/></keybind>
    <keybind key="W-p"><action name="ToggleAlwaysOnTop"/></keybind>

    <keybind key="W-Left"><action name="SnapToEdge" direction="left" combine="yes"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" combine="yes"/></keybind>
    <keybind key="W-Up"><action name="SnapToEdge" direction="up" combine="yes"/></keybind>
    <keybind key="W-Down"><action name="SnapToEdge" direction="down" combine="yes"/></keybind>

    <!-- Kenara TASI (boyut degismez) -->
    <keybind key="W-S-Left"><action name="MoveToEdge" direction="left" snapWindows="yes"/></keybind>
    <keybind key="W-S-Right"><action name="MoveToEdge" direction="right" snapWindows="yes"/></keybind>
    <keybind key="W-S-Up"><action name="MoveToEdge" direction="up" snapWindows="yes"/></keybind>
    <keybind key="W-S-Down"><action name="MoveToEdge" direction="down" snapWindows="yes"/></keybind>

    <!-- Komsu kenara kadar buyut / kucult -->
    <keybind key="W-A-Left"><action name="GrowToEdge" direction="left"/></keybind>
    <keybind key="W-A-Right"><action name="GrowToEdge" direction="right"/></keybind>
    <keybind key="W-A-Up"><action name="GrowToEdge" direction="up"/></keybind>
    <keybind key="W-A-Down"><action name="GrowToEdge" direction="down"/></keybind>
    <keybind key="W-A-S-Left"><action name="ShrinkToEdge" direction="left"/></keybind>
    <keybind key="W-A-S-Right"><action name="ShrinkToEdge" direction="right"/></keybind>
    <keybind key="W-A-S-Up"><action name="ShrinkToEdge" direction="up"/></keybind>
    <keybind key="W-A-S-Down"><action name="ShrinkToEdge" direction="down"/></keybind>

    <!-- PENCERE GECISI -->
    <keybind key="W-Tab"><action name="NextWindow" workspace="all"/></keybind>
    <keybind key="W-S-Tab"><action name="PreviousWindow" workspace="all"/></keybind>

    <keybind key="A-quotedbl">
      <action name="If">
        <query identifier="foot-main"/>
        <then>
          <action name="NextWindow" identifier="current" workspace="all"/>
        </then>
        <else>
          <action name="ForEach">
            <query identifier="foot-main"/>
            <then><action name="Focus"/><action name="Raise"/></then>
          </action>
        </else>
      </action>
    </keybind>
    <keybind key="A-S-quotedbl">
      <action name="If">
        <query identifier="foot-main"/>
        <then>
          <action name="PreviousWindow" identifier="current" workspace="all"/>
        </then>
        <else>
          <action name="ForEach">
            <query identifier="foot-main"/>
            <then><action name="Focus"/><action name="Raise"/></then>
          </action>
        </else>
      </action>
    </keybind>

    <!-- MASAUSTLERI -->
    <keybind key="W-1"><action name="GoToDesktop" to="1"/></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2"/></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3"/></keybind>

    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no"/></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no"/></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no"/></keybind>

    <keybind key="W-C-Left"><action name="GoToDesktop" to="left" wrap="yes"/></keybind>
    <keybind key="W-C-Right"><action name="GoToDesktop" to="right" wrap="yes"/></keybind>

    <keybind key="W-C-S-Left"><action name="SendToDesktop" to="left" follow="yes" wrap="yes"/></keybind>
    <keybind key="W-C-S-Right"><action name="SendToDesktop" to="right" follow="yes" wrap="yes"/></keybind>

    <keybind key="W-quotedbl"><action name="GoToDesktop" to="last"/></keybind>

    <keybind key="W-KP_7"><action name="SnapToRegion" region="top-left"/></keybind>
    <keybind key="W-KP_Home"><action name="SnapToRegion" region="top-left"/></keybind>
    <keybind key="W-KP_8"><action name="SnapToRegion" region="top"/></keybind>
    <keybind key="W-KP_Up"><action name="SnapToRegion" region="top"/></keybind>
    <keybind key="W-KP_9"><action name="SnapToRegion" region="top-right"/></keybind>
    <keybind key="W-KP_Prior"><action name="SnapToRegion" region="top-right"/></keybind>
    <keybind key="W-KP_4"><action name="SnapToRegion" region="left"/></keybind>
    <keybind key="W-KP_Left"><action name="SnapToRegion" region="left"/></keybind>
    <keybind key="W-KP_5"><action name="SnapToRegion" region="center"/></keybind>
    <keybind key="W-KP_Begin"><action name="SnapToRegion" region="center"/></keybind>
    <keybind key="W-KP_6"><action name="SnapToRegion" region="right"/></keybind>
    <keybind key="W-KP_Right"><action name="SnapToRegion" region="right"/></keybind>
    <keybind key="W-KP_1"><action name="SnapToRegion" region="bottom-left"/></keybind>
    <keybind key="W-KP_End"><action name="SnapToRegion" region="bottom-left"/></keybind>
    <keybind key="W-KP_2"><action name="SnapToRegion" region="bottom"/></keybind>
    <keybind key="W-KP_Down"><action name="SnapToRegion" region="bottom"/></keybind>
    <keybind key="W-KP_3"><action name="SnapToRegion" region="bottom-right"/></keybind>
    <keybind key="W-KP_Next"><action name="SnapToRegion" region="bottom-right"/></keybind>
  </keyboard>

  <mouse>
    <default/>
  </mouse>

  <windowRules>
    <windowRule identifier="*">
      <action name="SetDecorations" decorations="border" forceSSD="yes"/>
    </windowRule>

    <windowRule identifier="*firefox*" type="normal">
      <action name="Maximize"/>
    </windowRule>

    <windowRule identifier="tr-com-havelsan-uyap-system-editor-common-WPAppManager">
      <action name="SendToDesktop" to="III" follow="yes" />
    </windowRule>

    <windowRule identifier="foot-main">
      <action name="SnapToRegion" region="top-right"/>
    </windowRule>
  </windowRules>

</labwc_config>
